{
  "//": "Merge this into your project's .claude/settings.json (commit to share with the team). Copy the laravel-skills/hooks/ scripts into .claude/hooks/ first and keep them executable (chmod +x).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-migrations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pint-on-write.sh"
          }
        ]
      }
    ]
  }
}
